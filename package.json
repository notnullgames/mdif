{
  "name": "mdif",
  "type": "module",
  "version": "0.0.6",
  "description": "dialog/interactive fiction engine that lets you use markdown to describe conversations and games",
  "source": "index.js",
  "scripts": {
    "test": "node --test",
    "build": "npx -y microbundle",
    "prePublishOnly": "npm run build",
    "raylib": "node exaples/raylib.js",
    "cli": "node exaples/cli.js"
  },
  "exports": {
    "require": "./dist/mdif.cjs",
    "default": "./dist/mdif.modern.js"
  },
  "main": "./dist/mdif.cjs",
  "module": "./dist/mdif.module.js",
  "umd:main": "./dist/mdif.umd.js",
  "keywords": [
    "interactive",
    "fiction",
    "dialog",
    "game"
  ],
  "author": "David Konsumer <konsumer@jetboystudio.com>",
  "license": "MIT",
  "files": [
    "dist/mdif.cjs",
    "dist/mdif.cjs.map",
    "dist/mdif.modern.js",
    "dist/mdif.modern.js.map",
    "dist/mdif.module.js",
    "dist/mdif.module.js.map",
    "dist/mdif.umd.js",
    "dist/mdif.umd.js.map"
  ],
  "dependencies": {
    "front-matter": "^4.0.2",
    "markdown-ast": "^0.3.0"
  },
  "devDependencies": {
    "raylib": "latest"
  }
}
